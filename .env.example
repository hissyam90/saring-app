# ---------------------------------------------------------------------------
# Opsional: database pengujian E2E.
#
# `npm run test:e2e` memerlukan PostgreSQL sungguhan dan akan berhenti dengan
# pesan jelas bila DATABASE_URL tidak diset. Arahkan ke database uji TERPISAH
# (mis. saring_test), jalankan `npm run db:migrate`, lalu `npm run test:e2e`.
# Jangan mengarahkan ke database produksi.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/saring_test
# DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Google Safe Browsing API v5 (reputasi URL). Hanya dibaca di server.
# Tanpa key, pemeriksaan reputasi tidak berjalan; inspeksi lokal tetap aktif.
# ---------------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=

# ---------------------------------------------------------------------------
# Database PostgreSQL. Wajib di production; tanpa ini aplikasi menolak berjalan
# (fail closed) alih-alih memakai penyimpanan in-memory yang kehilangan data.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Set "disable" hanya bila server database tidak memakai TLS.
# Set "verify-full" untuk memverifikasi sertifikat server (disarankan bila
# penyedia database menyediakan CA tepercaya). Kosong = TLS tanpa verifikasi
# sertifikat, sesuai kebutuhan Heroku Postgres.
DATABASE_SSL=
# Jumlah koneksi maksimum per instance.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Sesi. Minimal 32 karakter acak. Wajib di production.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile. Site key boleh dibaca browser, secret hanya di server.
# Jika secret kosong di production, form yang dilindungi akan menolak request.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Opsional, khusus development/pengujian.
# SARING_TURNSTILE_BYPASS=1 melewati verifikasi CAPTCHA HANYA bila
# NODE_ENV bukan production. Nilai ini diabaikan di production.
# ---------------------------------------------------------------------------
# SARING_TURNSTILE_BYPASS=0

# Izinkan penyimpanan in-memory di production (JANGAN dipakai: data hilang saat
# instance restart dan tidak dibagi antar dyno). Hanya untuk demo sementara.
# SARING_ALLOW_MEMORY_STORE=0

# ---------------------------------------------------------------------------
# Proxy tepercaya untuk rate limiting. Tanpa nilai ini, semua request masuk
# satu bucket bersama sehingga batas login berlaku global.
#   cloudflare -> memakai header cf-connecting-ip (ditulis oleh Cloudflare)
#   heroku     -> memakai hop TERAKHIR x-forwarded-for (ditulis router Heroku)
# Set cloudflare HANYA bila seluruh trafik melewati proxy Cloudflare.
# ---------------------------------------------------------------------------
# SARING_TRUST_PROXY=cloudflare

# Kirim header HSTS. Aktifkan hanya setelah HTTPS berjalan stabil.
# SARING_ENABLE_HSTS=1

# ---------------------------------------------------------------------------
# Legacy: PhishTank tidak lagi dipakai di jalur runtime.
# ---------------------------------------------------------------------------
# PHISHTANK_APP_KEY=
