# Google Safe Browsing API v5 (provider reputasi URL utama).
# Hanya dibaca di server. JANGAN memakai prefix NEXT_PUBLIC_.
# Tanpa key, pemeriksaan reputasi eksternal tidak berjalan; inspeksi lokal tetap aktif.
GOOGLE_SAFE_BROWSING_API_KEY=

# Legacy: adapter PhishTank tidak lagi dipakai di jalur runtime.
# Endpoint checkurl menolak permintaan tanpa app key (HTTP 403).
# PHISHTANK_APP_KEY=

# Tidak ada provider reputasi nomor. Penilaian nomor memakai aturan lokal.
